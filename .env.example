# Asana Configuration
ASANA_ACCESS_TOKEN=your_personal_access_token_here
ASANA_PROJECT_GID=1234567890123456

# Google Sheets Configuration
GOOGLE_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit
GOOGLE_CREDENTIALS_PATH=credentials/service-account.json

# Lead Scraper - Pappers API (enrichissement)
PAPPERS_API_KEY=your_pappers_api_key_here

# Lead Scraper - HubSpot CRM (optionnel)
HUBSPOT_API_KEY=your_hubspot_private_app_token_here

# Lead Scraper - Anthropic API (recherche langage naturel, optionnel)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# GetSales Sync - API GetSales.io
GETSALES_API_KEY=your_getsales_api_key_here

# ========================================
# Application Configuration
# ========================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Timezone
TZ=Europe/Paris

# ========================================
# Streamlit Configuration (Docker)
# ========================================

# Server settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# File watcher (auto for dev with hot reload, none for production)
STREAMLIT_SERVER_FILE_WATCHER_TYPE=auto
